# Hosts permitidos, separados por vírgula. Use * apenas em desenvolvimento.
ALLOWED_HOSTS=*

# GeoVictoria API
GEOVICTORIA_USER=
GEOVICTORIA_PASSWORD=

# Banco de dados SQLite
# SQLITE_PATH: Caminho do banco principal. Mantenha no SSD local (ou vazio para o padrão do projeto) para performance máxima.
SQLITE_PATH=
# SQLITE_BACKUP_PATH: Caminho no servidor da empresa (ex: F:\Backups\db.sqlite3 ou \\servidor\pasta\db.sqlite3). O sistema sincroniza automaticamente em segundo plano.
SQLITE_BACKUP_PATH=
TESTES_ANEXOS_PATH=
# Caminho opcional da planilha de De-Para de Verbas (ex: C:\dados\de_para_verbas.xlsx ou \\servidor\pasta\de_para_verbas.xlsx)
PLANILHA_VERBAS_PATH=

# Configurações de envio de E-mail (Exemplo para o Resend)
# Deixe EMAIL_BACKEND vazio ou com o valor abaixo para exibir no console em ambiente local.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# URL do Frontend React
FRONTEND_URL=